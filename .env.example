# Copy to .env for local development, or set as Codespaces / Vercel secrets.
# Never commit real values.

# Neon pooled connection (host contains "-pooler"). Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection (no "-pooler"). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
