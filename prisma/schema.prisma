// Chrono data model (SPEC.md, "Tech stack and data model").
// Money is always integer cents (ZAR). Business dates are date-only (@db.Date).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled connection
  directUrl = env("DIRECT_URL")   // Neon direct connection, used by migrations
}

enum OrderStatus {
  DRAFT
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum PaymentKind {
  DEPOSIT
  BALANCE
  INSTALMENT
}

enum DateCertainty {
  CONFIRMED
  ESTIMATED
  UNKNOWN
}

enum CostCategory {
  INGREDIENTS
  MATERIALS
  PACKAGING
  TRANSPORT
  LABOUR
  OTHER
}

enum Direction {
  IN
  OUT
}

enum Recurrence {
  NONE
  WEEKLY
  MONTHLY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  isDemo       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  business     Business?
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 hash of the session token; the raw token only lives in the cookie.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Business {
  id                String       @id @default(cuid())
  userId            String       @unique
  name              String
  type              String
  openingCashCents  Int
  openingCashDate   DateTime     @db.Date
  safetyBufferCents Int          @default(50000)
  paydayWindowStart Int          @default(25)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customers         Customer[]
  orders            Order[]
  commitments       Commitment[]
}

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@index([businessId])
}

model Order {
  id         String         @id @default(cuid())
  businessId String
  customerId String
  title      String
  valueCents Int
  status     OrderStatus    @default(DRAFT)
  createdAt  DateTime       @default(now())
  decidedAt  DateTime?
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments   OrderPayment[]
  costs      OrderCost[]
  scenarios  Scenario[]
  shares     QuoteShare[]

  @@index([businessId, status])
  @@index([customerId])
}

model OrderPayment {
  id                  String        @id @default(cuid())
  orderId             String
  kind                PaymentKind
  amountCents         Int
  expectedDate        DateTime?     @db.Date
  dateCertainty       DateCertainty @default(ESTIMATED)
  receivedDate        DateTime?     @db.Date
  receivedAmountCents Int?
  order               Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderCost {
  id             String        @id @default(cuid())
  orderId        String
  description    String
  category       CostCategory  @default(OTHER)
  estimatedCents Int
  dueDate        DateTime?     @db.Date
  dateCertainty  DateCertainty @default(ESTIMATED)
  paidDate       DateTime?     @db.Date
  paidCents      Int?
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Commitment {
  id          String     @id @default(cuid())
  businessId  String
  description String
  direction   Direction
  amountCents Int
  startDate   DateTime   @db.Date
  recurrence  Recurrence @default(NONE)
  endDate     DateTime?  @db.Date
  active      Boolean    @default(true)
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Scenario {
  id        String   @id @default(cuid())
  orderId   String
  name      String
  /// Overrides applied before running the engine: deposit, dates, amounts.
  overrides Json
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model QuoteShare {
  id        String    @id @default(cuid())
  orderId   String
  /// Random 128-bit token, URL-safe.
  token     String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
